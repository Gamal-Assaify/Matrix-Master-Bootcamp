// ==========================================
// Exercise 1: Print 1 - 135
// ==========================================

for (let i = 1; i <= 135; i++) {
    console.log(i);
}


// ==========================================
// Exercise 2: Print Odd Numbers 1 - 135
// ==========================================

for (let i = 1; i <= 135; i++) {
    if (i % 2 !== 0) {
        console.log(i);
    }
}


// ==========================================
// Exercise 3: Sum of Printed Numbers
// ==========================================

let sum = 0;

for (let i = 0; i <= 135; i++) {
    sum += i;

    console.log(`Number is: ${i} Sum: ${sum}`);
}


// ==========================================
// Exercise 4: Print the Elements of an Array
// ==========================================

const x1 = [1, 4, 2, 12];

for (let i = 0; i < x1.length; i++) {
    console.log(x1[i]);
}


// ==========================================
// Exercise 5: Find Max
// ==========================================

const x2 = [2, -3, -1, 0, 7, 5];

let max = x2[0];

for (let i = 1; i < x2.length; i++) {

    if (x2[i] > max) {
        max = x2[i];
    }

}

console.log("Maximum value:", max);


// ==========================================
// Exercise 6: Get Average
// ==========================================

const x3 = [2, 1, 3];

let total = 0;

for (let i = 0; i < x3.length; i++) {
    total += x3[i];
}

let average = total / x3.length;

console.log("Average:", average);


// ==========================================
// Exercise 7: Eliminate the Negatives
// ==========================================

const x4 = [2, -1, 4, -3];

for (let i = 0; i < x4.length; i++) {

    if (x4[i] < 0) {
        x4[i] = 0;
    }

}

console.log(x4);


// ==========================================
// Exercise 8: Number to String
// Replace negative numbers with "Turing"
// ==========================================

const x5 = [1, -4, 0, -1];

for (let i = 0; i < x5.length; i++) {

    if (x5[i] < 0) {
        x5[i] = "Turing";
    }

}

console.log(x5);

// Output:
// [1, "Turing", 0, "Turing"]